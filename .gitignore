# Node
node_modules/
npm-debug.log

# Generated: frontend/config.js by `npm run env` locally (staging) and by the deploy
# workflow per tree in CI; .clasp.json by the deploy workflow only, since nothing local
# pushes to Apps Script. Never committed, so no script id or endpoint URL lives in git and a
# form cannot inherit the wrong environment's backend.
.clasp.json
frontend/config.js

# Clasp
.clasprc.json

# Environment files with admin tokens (NEVER COMMIT)
# .env is the only one used; the two prefixed files are legacy, still ignored so an old
# copy on someone's machine can never be committed by accident.
.env
.env.staging
.env.production

# OS / editor cruft
.DS_Store
*.swp
*.swo

# Scratch space — not part of the project
# Scratch space: screenshots, captures, anything worth keeping while working and not
# worth committing. The directory itself is tracked so it exists in a fresh clone.
/tmp/*
!/tmp/.gitkeep

# The published site as `npm run serve` assembles it locally
_site/
