# Node
node_modules/
npm-debug.log

# Generated by `npm run env:staging|production` locally, by the deploy workflow from a
# secret in CI. Never committed, so no script id or endpoint URL lives in git and a form
# cannot inherit the wrong environment's backend.
.clasp.json
frontend/config.js

# Clasp
.clasprc.json

# Environment files with admin tokens (NEVER COMMIT)
# .env is the only one used; the two prefixed files are legacy, still ignored so an old
# copy on someone's machine can never be committed by accident.
.env
.env.staging
.env.production

# OS / editor cruft
.DS_Store
*.swp
*.swo

# Scratch space — not part of the project
/tmp/
